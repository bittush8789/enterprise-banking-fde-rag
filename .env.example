# ==============================================================================
# BankAssist AI - Environment Configuration (Pinecone Serverless Vector DB)
# ==============================================================================

# LLM Configuration (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Pinecone Serverless Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=bankassist-banking-docs
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Database Configuration (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bankassist
MYSQL_USER=root 
MYSQL_PASSWORD=root 

# Optional SQLite Override (leave empty to use MySQL, or set sqlite:///./data/bankassist.db for local lightweight testing)
DATABASE_URL=

# JWT Authentication
JWT_SECRET_KEY=super_secret_bankassist_jwt_key_change_in_production_2026_secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Hugging Face Local Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# RAG & Grounding Guardrails
RETRIEVAL_THRESHOLD=0.15
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# Upload Configuration
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE_MB=20

# Environment Mode
ENVIRONMENT=development
